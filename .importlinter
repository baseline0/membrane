[importlinter]
root_packages =
    malta
    benchmarks
    cyprus

# The boundary: the engine never depends on the benchmarks; benchmarks may use the engine.
[importlinter:contract:malta-does-not-import-benchmarks]
name = malta never imports benchmarks
type = forbidden
source_modules =
    malta
forbidden_modules =
    benchmarks

[importlinter:contract:cyprus-is-independent]
name = cyprus does not import malta or benchmarks
type = forbidden
source_modules =
    cyprus
forbidden_modules =
    malta
    benchmarks

