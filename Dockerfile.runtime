# Runtime image for the malta P-system CLI. Built from this repo only: the lock file pins every dependency.
FROM python:3.13-slim

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY . .
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"
CMD ["malta", "run", "--idx", "1", "--seed", "0"]
